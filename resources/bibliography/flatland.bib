@InProceedings{chen2021symmetry,
  author       = {Chen, Zhe and Harabor, Daniel D. and Li, Jiaoyang and Stuckey, Peter J.},
  booktitle    = {Proceedings of the AAAI Conference on Artificial Intelligence},
  title        = {Symmetry Breaking for k-Robust Multi-Agent Path Finding},
  year         = {2021},
  month        = {May},
  number       = {14},
  pages        = {12267--12274},
  volume       = {35},
  abstractnote = {During Multi-Agent Path Finding (MAPF) problems, agentscan be delayed by unexpected events. To address suchsituations recent work describes k-Robust Conflict-BasedSearch (k-CBS): an algorithm that produces coordinated andcollision-free plan that is robust for up tokdelays. In thiswork we introducing a variety of pairwise symmetry break-ing constraints, specific tok-robust planning, that can effi-ciently find compatible and optimal paths for pairs of con-flicting agents. We give a thorough description of the newconstraints and report large improvements to success rate ina range of domains including: (i) classic MAPF benchmarks;(ii) automated warehouse domains and; (iii) on maps fromthe 2019 Flatland Challenge, a recently introduced railwaydomain wherek-robust planning can be fruitfully applied toschedule trains.},
  doi          = {10.1609/aaai.v35i14.17456},
  file         = {:chen2021symmetry.pdf:PDF},
  groups       = {others, also_uses},
  journal      = {Proceedings of the AAAI Conference on Artificial Intelligence},
  url          = {https://ojs.aaai.org/index.php/AAAI/article/view/17456},
}

